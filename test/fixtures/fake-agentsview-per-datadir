#!/usr/bin/env bash
# Emits a DIFFERENT v1 session_stats blob depending on AGENT_VIEWER_DATA_DIR,
# so a test can prove which data dirs were actually queried. The default (env
# unset, or any dir not containing "extra-home") is the primary home.
#
# Numbers are chosen so every merge rule is falsifiable:
#   primary: Task=10, subagents_per_session=0.05  => recovered N = 200
#   extra:   Task=2,  subagents_per_session=0.04  => recovered N = 50
#   merged:  (10+2)/(200+50) = 0.048   <- differs from BOTH inputs
#   plan:    primary 0.01*200=2, extra 0.02*50=1  => 3/250 = 0.012
if [[ "$1" == "stats" ]]; then
  # A home whose data dir is unreadable: exit non-zero so collectSessionStats
  # takes its skip-and-log path for that home only.
  if [[ "${AGENT_VIEWER_DATA_DIR:-}" == *broken-home* ]]; then
    echo "cannot open database" >&2
    exit 2
  fi
  if [[ "${AGENT_VIEWER_DATA_DIR:-}" == *extra-home* ]]; then
    cat <<'JSON'
{"schema_version":1,"window":{"days":28},"totals":{"sessions_all":50,"messages_total":500},"tool_mix":{"by_category":{"Bash":20,"Task":2},"total_calls":22},"adoption":{"subagents_per_session":0.04,"plan_mode_rate":0.02,"distinct_skills":3},"generated_at":"2026-04-18T00:00:00Z"}
JSON
  else
    cat <<'JSON'
{"schema_version":1,"window":{"days":28},"totals":{"sessions_all":200,"messages_total":2000},"tool_mix":{"by_category":{"Bash":100,"Task":10},"total_calls":110},"adoption":{"subagents_per_session":0.05,"plan_mode_rate":0.01,"distinct_skills":7},"generated_at":"2026-04-18T00:00:00Z"}
JSON
  fi
  exit 0
fi
echo "unexpected args: $*" >&2
exit 2
